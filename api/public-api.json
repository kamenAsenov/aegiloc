        "HealingAuditEvent",
        "HealingExecutionAuditEvent",
        "HealingExecutionReason",
        "HealingExecutionStatus",
        "HealingMode",
        "HealingPolicy",
        "HealingProposal",
        "HealingProposalBundle",
        "HealingProposalBundleVerification",
        "HealingProposalEvidence",
        "HealingProposalRejection",
        "HealingProposalRejectionReason",
        "HealingProposalVerification",
        "HealingProposalVerificationIssue",

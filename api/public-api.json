      "version": 1
    },
    {
      "subpath": "./evidence-summary-schema",
      "path": "./registry/evidence-summary.schema.json",
      "id": "https://github.com/kamenAsenov/aegiloc/registry/evidence-summary.schema.json",
      "version": 2
    },
    {
      "subpath": "./fingerprint-proposal-schema",
      "path": "./registry/fingerprint-proposals.schema.json",
      "id": "https://github.com/kamenAsenov/aegiloc/registry/fingerprint-proposals.schema.json",
      "version": 1
    },
    {
      "subpath": "./governance-policy-schema",
      "path": "./registry/governance-policy.schema.json",
      "id": "https://github.com/kamenAsenov/aegiloc/registry/governance-policy.schema.json",
      "version": 1
    },
    {
      "subpath": "./health-summary-schema",
      "path": "./registry/health-summary.schema.json",
      "id": "https://github.com/kamenAsenov/aegiloc/registry/health-summary.schema.json",
      "version": 1
    },
    {
      "subpath": "./proposal-schema",
      "path": "./registry/healing-proposals.schema.json",
      "id": "https://github.com/kamenAsenov/aegiloc/registry/healing-proposals.schema.json",
      "version": 3
    },
    {
      "subpath": "./registry-schema",
      "path": "./registry/targets.schema.json",
      "id": "https://github.com/kamenAsenov/aegiloc/registry/targets.schema.json",
      "version": 1
    }
  ]
}

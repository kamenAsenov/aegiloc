{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kamenAsenov/healwright/registry/targets.schema.json",
  "title": "Healwright target registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaults", "targets"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "defaults": { "$ref": "#/$defs/thresholds" },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidenceThreshold", "minimumScoreMargin"],
      "properties": {
        "confidenceThreshold": { "$ref": "#/$defs/probability" },
        "minimumScoreMargin": { "$ref": "#/$defs/probability" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "primary", "fingerprint", "policy"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "primary": { "$ref": "#/$defs/primary" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "policy": { "$ref": "#/$defs/policy" }
      }
    },
    "primary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "role"],
          "properties": {
            "type": { "const": "role" },
            "role": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "exact": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["label", "text"] },
            "value": { "type": "string", "minLength": 1 },
            "exact": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["testId", "css"] },
            "value": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accessibleRole": { "type": "string", "minLength": 1 },
        "accessibleName": { "type": "string", "minLength": 1 },
        "stableAttributes": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "visibleText": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "ancestorText": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "neighborText": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedActions", "healing"],
      "properties": {
        "allowedActions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["click", "fill", "check", "selectOption"] }
        },
        "healing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "confidenceThreshold", "minimumScoreMargin"],
          "properties": {
            "enabled": { "type": "boolean" },
            "confidenceThreshold": { "$ref": "#/$defs/probability" },
            "minimumScoreMargin": { "$ref": "#/$defs/probability" }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kamenAsenov/healwright/registry/targets.schema.json",
  "title": "Healwright target registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaults", "targets"],
  "properties": {
    "$schema": { "$ref": "#/$defs/nonEmptyString" },
    "version": { "const": 1 },
    "defaults": { "$ref": "#/$defs/thresholds" },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/nonEmptyString" },
      "additionalProperties": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "ariaRole": {
      "enum": [
        "alert",
        "alertdialog",
        "application",
        "article",
        "banner",
        "blockquote",
        "button",
        "caption",
        "cell",
        "checkbox",
        "code",
        "columnheader",
        "combobox",
        "complementary",
        "contentinfo",
        "definition",
        "deletion",
        "dialog",
        "directory",
        "document",
        "emphasis",
        "feed",
        "figure",
        "form",
        "generic",
        "grid",
        "gridcell",
        "group",
        "heading",
        "img",
        "insertion",
        "link",
        "list",
        "listbox",
        "listitem",
        "log",
        "main",
        "marquee",
        "math",
        "meter",
        "menu",
        "menubar",
        "menuitem",
        "menuitemcheckbox",
        "menuitemradio",
        "navigation",
        "none",
        "note",
        "option",
        "paragraph",
        "presentation",
        "progressbar",
        "radio",
        "radiogroup",
        "region",
        "row",
        "rowgroup",
        "rowheader",
        "scrollbar",
        "search",
        "searchbox",
        "separator",
        "slider",
        "spinbutton",
        "status",
        "strong",
        "subscript",
        "superscript",
        "switch",
        "tab",
        "table",
        "tablist",
        "tabpanel",
        "term",
        "textbox",
        "time",
        "timer",
        "toolbar",
        "tooltip",
        "tree",
        "treegrid",
        "treeitem"
      ]
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidenceThreshold", "minimumScoreMargin"],
      "properties": {
        "confidenceThreshold": { "$ref": "#/$defs/probability" },
        "minimumScoreMargin": { "$ref": "#/$defs/probability" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "primary", "fingerprint", "policy"],
      "properties": {
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "primary": { "$ref": "#/$defs/primary" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "policy": { "$ref": "#/$defs/policy" }
      }
    },
    "primary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "role"],
          "properties": {
            "type": { "const": "role" },
            "role": { "$ref": "#/$defs/ariaRole" },
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "exact": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["label", "text"] },
            "value": { "$ref": "#/$defs/nonEmptyString" },
            "exact": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["testId", "css"] },
            "value": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ]
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accessibleRole": { "$ref": "#/$defs/ariaRole" },
        "accessibleName": { "$ref": "#/$defs/nonEmptyString" },
        "stableAttributes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/nonEmptyString" },
          "additionalProperties": { "$ref": "#/$defs/nonEmptyString" }
        },
        "visibleText": { "$ref": "#/$defs/nonEmptyString" },
        "tag": { "$ref": "#/$defs/nonEmptyString" },
        "ancestorText": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "neighborText": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "$ref": "#/$defs/probability" },
            "y": { "$ref": "#/$defs/probability" },
            "width": { "$ref": "#/$defs/probability" },
            "height": { "$ref": "#/$defs/probability" }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedActions", "healing"],
      "properties": {
        "allowedActions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["click", "fill", "check", "selectOption"] }
        },
        "healing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "confidenceThreshold", "minimumScoreMargin"],
          "properties": {
            "enabled": { "type": "boolean" },
            "confidenceThreshold": { "$ref": "#/$defs/probability" },
            "minimumScoreMargin": { "$ref": "#/$defs/probability" }
          }
        }
      }
    }
  }
}

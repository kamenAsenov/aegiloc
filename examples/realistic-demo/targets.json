{
  "$schema": "../../registry/targets.schema.json",
  "version": 1,
  "defaults": {
    "confidenceThreshold": 0.9,
    "minimumScoreMargin": 0.15
  },
  "targets": {
    "checkout.applyDiscount": {
      "description": "Apply the fixture storefront discount",
      "primary": {
        "type": "text",
        "value": "Apply discount",
        "exact": true
      },
      "fingerprint": {
        "accessibleRole": "button",
        "accessibleName": "Apply discount",
        "visibleText": "Apply discount",
        "tag": "button",
        "ancestorText": ["Checkout"]
      },
      "policy": {
        "allowedActions": ["click"],
        "executionRisk": "automatic",
        "healing": {
          "enabled": true,
          "confidenceThreshold": 0.91,
          "minimumScoreMargin": 0.15
        }
      }
    },
    "checkout.terms": {
      "description": "Accept the fixture storefront terms",
      "primary": {
        "type": "testId",
        "value": "checkout-terms"
      },
      "fingerprint": {
        "accessibleRole": "checkbox",
        "accessibleName": "I agree to the store terms",
        "tag": "input",
        "stableAttributes": {
          "name": "terms",
          "type": "checkbox"
        },
        "neighborText": ["I agree to the store terms"]
      },
      "policy": {
        "allowedActions": ["check"],
        "executionRisk": "automatic",
        "healing": {
          "enabled": true,
          "confidenceThreshold": 0.94,
          "minimumScoreMargin": 0.18
        }
      }
    }
  }
}
